# Copy to .env and fill in. Loaded by config.py.

# Required: Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: model name (default gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: set to 1 to run the whole pipeline with a deterministic offline
# stub instead of calling Gemini. Useful for testing the build with no key.
LLM_MOCK=0

# Optional: where generated artefacts (audio, video, db) are written.
AITEACHER_WORKDIR=output
