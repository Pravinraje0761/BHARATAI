# Copy to .env and fill in. Loaded by config.py (setdefault — real env wins).

# ---------------------------------------------------------------------------
# LLM providers. The engine cascades Groq -> NVIDIA NIM -> Gemini -> offline
# mock. At least one key is strongly recommended for real lessons; with none,
# the deterministic offline mock only covers a few sample topics.
# ---------------------------------------------------------------------------

# Groq LPU (fastest). https://console.groq.com/keys
# Groq's free-tier model lineup changes over time; if this model 404s for
# your key, run `GET {GROQ_BASE_URL}/models` with your key to see what's
# actually available and update this value.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA NIM. https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Set to 1 to force the offline deterministic engine (no network, for tests).
LLM_MOCK=0

# ---------------------------------------------------------------------------
# Firebase Cloud Backend (Auth, Google Sign-In & Firestore sync)
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional: Path to serviceAccountKey.json for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# HTTP bind. Most PaaS hosts inject PORT automatically.
PORT=8000
HOST=0.0.0.0

# Set to 1 once deployed behind HTTPS, so the login session cookie is marked
# Secure. Leave at 0 for local http://localhost dev (browsers drop Secure
# cookies over plain HTTP). See DEPLOY.md "Auth gate" section.
COOKIE_SECURE=0

# Where generated audio/video/db are written.
AITEACHER_WORKDIR=output
